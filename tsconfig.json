{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"baseUrl": ".",
		"paths": {
			"@side-quest/shared/*": ["apps/shared/*"]
		}
	},
	"include": ["tsup.config.ts", "apps/**/*"],
	"exclude": ["node_modules"],
	"composite": true
}
