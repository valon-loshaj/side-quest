{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"baseUrl": ".",
		"paths": {
			"@side-quest/shared/*": ["apps/shared/*"]
		}
	},
	"include": ["tsup.config.ts"],
	"exclude": ["node_modules"],
	"references": [{ "path": "apps/frontend" }, { "path": "apps/backend" }, { "path": "apps/shared" }]
}
