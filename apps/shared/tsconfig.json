{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"composite": true,
		"declaration": true,
		"declarationMap": true,
		"rootDir": ".",
		"outDir": "dist"
	},
	"include": ["types/**/*.ts"],
	"exclude": ["node_modules"]
}
